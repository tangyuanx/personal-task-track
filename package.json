{
  "name": "personal-task-track",
  "version": "0.1.85",
  "description": "A local-first personal task flow tracker for programmer daily work.",
  "private": true,
  "license": "UNLICENSED",
  "author": "xuesinian <tangyuan.sn@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tangyuanx/personal-task-track.git"
  },
  "bugs": {
    "url": "https://github.com/tangyuanx/personal-task-track/issues"
  },
  "homepage": "https://github.com/tangyuanx/personal-task-track#readme",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "build:milkdown": "node scripts/build-milkdown.cjs",
    "test": "node --test scripts/test.cjs",
    "check": "npm run build:milkdown && node --check src/app.js && node --check electron/main.cjs && node --check electron/preload.cjs && node --check electron/storage.cjs && node --check scripts/after-pack.cjs && node --check scripts/build.cjs && node --check scripts/build-milkdown.cjs && node --check scripts/make-ico.cjs && node --check scripts/test.cjs && npm test",
    "dist": "node scripts/build.cjs",
    "dist:mac": "node scripts/build.cjs --mac",
    "dist:win": "node scripts/build.cjs --win"
  },
  "build": {
    "appId": "io.github.tangyuanx.personal-task-track",
    "productName": "Personal Task Track",
    "icon": "build/icon",
    "asar": true,
    "afterPack": "scripts/after-pack.cjs",
    "directories": {
      "output": "release"
    },
    "files": [
      "index.html",
      "src/**/*",
      "electron/**/*",
      "build/icon.*",
      "package.json",
      "!**/._*",
      "!**/.DS_Store"
    ],
    "mac": {
      "identity": null,
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "executableName": "PersonalTaskTrack",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "@milkdown/crepe": "^7.21.3",
    "electron": "^42.7.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1"
  },
  "dependencies": {}
}
